# Dependencies
node_modules/
/backend/vendor/
/backend/Modules/*/vendor/

# Build output (built by CI / on deploy, never committed)
/apps/*/dist/
/archive/*/dist/
*.tsbuildinfo

# Environment (copy from .env.example)
.env
.env.local
.env.*.local
!.env.example

# Front-end caches
.vite/

# Laravel generated / runtime
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
backend/storage/*.zip
backend/cachePath/
backend/.phpunit.result.cache
backend/.tmp-appdata/

# IDE / editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp
*.log
npm-debug.log*
*.zip~

# Server deploy snapshots and database dumps (never commit)
/production/
*.sql
*.sql.gz

# Source maps (large, generated by builds)
*.map

# User-uploaded content (customer data, not part of the source)
backend/public/uploads/
backend/public/storage

# Laravel installer marker (per-environment)
backend/storage/installed
